# 编译文件、本地二进制与打包产物。
*.class
*.jar
*.war
*.ear
*.nar
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# 运行日志、诊断转储与临时文件。
*.log
*.log.*
*.hprof
*.heapdump
*.jfr
*.dump
*.dmp
core.[0-9]*
*.tmp
*.temp
*.bak
*.orig
*.rej

# 证据目录中的上述文件属于随书材料；保留构建包装器所需工具包。
!**/evidence/**
!**/.mvn/wrapper/maven-wrapper.jar

# 操作系统目录元数据。
.DS_Store
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# 本地编辑器配置、工作区与备份。
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
*~
*.swp
*.swo
.history/

# 各级构建输出、作者工具依赖与缓存。
target/
build/
out/
dist/
node_modules/
.cache/
.npm/
.pnpm-store/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Maven 生成的备份和发布辅助文件；保留构建配置及包装器。
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
.flattened-pom.xml
.mvn/timing.properties

# 本地环境配置；示例与模板可以纳入版本管理。
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 大型原始材料与临时产物，保留目录占位。
/artifacts/*
!/artifacts/.gitkeep

# 本地交付副本与归档；正式维护源和证据仍在项目原位置。
/交付/

# 正文、静态高亮页面、图源、显示图和依赖锁文件正常保留。
